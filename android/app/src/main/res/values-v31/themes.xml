<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ copy of Theme.Game2048: adds the splash icon. The per-theme splash styles
         (Theme.Game2048.Splash<id>) inherit this, so only splashAccent / splashOnAccent
         differ per theme. Keep in sync with values/themes.xml. -->
    <style name="Theme.Game2048" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="splashAccent">@color/splash_accent_0</item>
        <item name="splashOnAccent">@color/splash_on_accent_0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
